{
  "name": "osnova",
  "private": true,
  "type": "module",
  "description": "Osnova design system monorepo: design tokens and React components.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksandar381radosavljevic/design-system.git"
  },
  "workspaces": [
    "packages/tokens",
    "packages/react"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
